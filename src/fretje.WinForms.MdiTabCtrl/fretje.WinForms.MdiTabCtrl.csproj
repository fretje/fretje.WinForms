<Project Sdk="fretje.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0-windows;net10.0-windows;net472</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Package metadata -->
    <PackageId>fretje.WinForms.MdiTabCtrl</PackageId>
    <Description>A highly configurable MDI tab control for WinForms, converted from JacksiroKe/MdiTabCtrl</Description>
    <PackageTags>winforms;mdi;tabcontrol;tabbed</PackageTags>

    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" />
  </ItemGroup>

</Project>
